    "corruption.alert.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallilex konnte die Einstellungen nicht lesen und hat sie zurückgesetzt. Die alte Einstellungsdatei wurde zur Fehlersuche aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallilex couldn't read its settings and started fresh. Your old settings file was kept for troubleshooting."
