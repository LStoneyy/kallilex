    "settings.shareSheetGuide.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Teilen-Menü in einer beliebigen App (das Quadrat mit dem Pfeil nach oben), scrolle die obere App-Reihe bis zum Ende, tippe auf „Mehr“, aktiviere dann Kallilex und ziehe es nach oben in deine Favoriten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the share sheet from any app (the square with an arrow pointing up), scroll the top row of apps all the way to the end, tap \"More\", then turn on Kallilex and drag it near the top of your favorites."
          }
        }
      }
    },
    "settings.shareSheetGuide.button": {
