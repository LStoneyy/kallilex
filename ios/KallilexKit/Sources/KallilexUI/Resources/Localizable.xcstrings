{
  "sourceLanguage": "en",
  "strings": {
    "consent.allow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        }
      }
    },
    "consent.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Prompt ausführst, werden der geteilte Text und die Anweisung des Prompts zur Verarbeitung an %@ (%@) gesendet. Kallilex selbst sammelt oder speichert deinen Text nicht; es gilt die Datenschutzerklärung des Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you run a prompt, the text you share and the prompt's instruction are sent to %@ (%@) to be processed. Kallilex doesn't collect or store your text itself; the provider's privacy policy applies."
          }
        }
      }
    },
    "consent.notNow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "consent.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text an %@ senden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send text to %@?"
          }
        }
      }
    },
