{
  "sourceLanguage": "en",
  "strings": {
    "error.contextTooLong": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text ist zu lang für das Kontextfenster dieses Modells. Versuche eine kürzere Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is too long for this model's context window. Try a shorter selection."
          }
        }
      }
    },
    "error.declined": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell auf dem Gerät hat die Verarbeitung dieses Texts abgelehnt — versuche eine andere Formulierung oder eine kürzere Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model declined to process this text — try different wording or a shorter selection."
          }
        }
      }
    },
    "error.http": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit HTTP %lld geantwortet: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered HTTP %lld: %@"
          }
        }
      }
    },
    "error.invalidBaseUrl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Basis-URL ist ungültig: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The base URL is invalid: %@"
          }
        }
      }
    },
    "error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine unerwartete Antwort gesendet: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent an unexpected response: %@"
          }
        }
      }
    },
    "error.localNetworkDenied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallilex darf nicht auf dein lokales Netzwerk zugreifen. Aktiviere für Kallilex den Zugriff auf das lokale Netzwerk unter Einstellungen → Datenschutz & Sicherheit → Lokales Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kallilex isn't allowed to reach your local network. Turn on Local Network for Kallilex in Settings → Privacy & Security → Local Network."
          }
        }
      }
    },
    "error.missingModel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Profil ist kein Modell eingerichtet — richte eines in den Einstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model is configured for this profile — set one in Settings."
          }
        }
      }
    },
    "error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage hat nach %lld s das Zeitlimit überschritten — der Endpunkt ist möglicherweise langsam oder überlastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out after %lld s — the endpoint may be slow or overloaded."
          }
        }
      }
    },
    "error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      },
      "shouldTranslate": false
    },
    "error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpunkt nicht erreichbar — läuft der Server? (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the endpoint — is the server running? (%@)"
          }
        }
      }
    },
    "ondevice.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell auf dem Gerät ist gerade ausgelastet. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model is busy right now. Try again in a moment."
          }
        }
      }
    },
    "ondevice.error.unsupportedLanguage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sprache wird vom Modell auf dem Gerät nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language isn't supported by the on-device model."
          }
        }
      }
    },
    "ondevice.reason.appleIntelligenceNotEnabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings."
          }
        }
      }
    },
