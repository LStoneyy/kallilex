    "provider.hint.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt beim ersten Verwenden dieses Anbieters nach dem Zugriff auf das lokale Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will ask for Local Network access the first time you use this provider."
          }
        }
      }
    },
