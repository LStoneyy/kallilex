    "provider.validation.invalidBaseUrl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige http:// oder https:// URL ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid http:// or https:// URL."
          }
        }
      }
    },
    "provider.warning.insecureUrl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt http:// nur in deinem lokalen Netzwerk. Verwende für diesen Server https://."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only allows http:// on your local network. Use https:// for this server."
          }
        }
      }
