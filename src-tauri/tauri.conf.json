{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kallilex",
  "version": "0.2.0",
  "identifier": "com.webcommits.kallilex",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "Kallilex",
        "width": 400,
        "height": 300,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true,
        "center": false,
        "windowEffects": { "effects": ["popover"], "radius": 10 }
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Kallilex Settings",
        "width": 600,
        "height": 400,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-" },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/com.webcommits.kallilex.desktop": "packaging/com.webcommits.kallilex.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/com.webcommits.kallilex.desktop": "packaging/com.webcommits.kallilex.desktop"
        }
      }
    }
  }
}
